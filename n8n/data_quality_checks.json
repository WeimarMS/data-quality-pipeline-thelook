        "sqlQuery": "SELECT\n  'orders_without_items' AS check_name,\n  COUNT(*) AS problem_rows\nFROM `bigquery-public-data.thelook_ecommerce.orders` o\nWHERE NOT EXISTS (\n  SELECT 1\n  FROM `bigquery-public-data.thelook_ecommerce.order_items` oi\n  WHERE oi.order_id = o.order_id\n)",
