    {
      "parameters": {
        "jsCode": "const QUERY_NODES = ['01 Orders without items', '02 Duplicate orders', '03 Items with missing product', '04 Impossible dates', '05 Nulls in key fields', '06 Item count mismatch', '07 Orders with missing user'];\nconst TEST_NODE = 'TEST - Forced failure';\nconst esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nfunction readNode(name) {\n  try { return $(name).all(); } catch (e) { return null; }\n}\n\nconst results = [];\nfor (const name of QUERY_NODES.concat([TEST_NODE])) {\n  const isTest = name === TEST_NODE;\n  const items = readNode(name);\n  if (!items || items.length === 0) {\n    if (!isTest) results.push({ check_name: 'query_error: ' + name, problem_rows: null, error: 'The node did not return any result.' });\n    continue;\n  }\n  for (const item of items) {\n    const j = item.json || {};\n    if (j.error) {\n      results.push({ check_name: 'query_error: ' + name, problem_rows: null, error: String(j.error.message || j.error) });\n      continue;\n    }\n    if (j.check_name === undefined) {\n      if (!isTest) results.push({ check_name: 'query_error: ' + name, problem_rows: null, error: 'The result has no check_name column.' });\n      continue;\n    }\n    const raw = j.problem_rows;\n    const rows = (raw === null || raw === undefined || raw === '') ? NaN : Number(raw);\n    if (!Number.isFinite(rows)) {\n      results.push({ check_name: 'query_error: ' + name, problem_rows: null, error: 'problem_rows is not a number: ' + raw });\n      continue;\n    }\n    results.push({ check_name: String(j.check_name), problem_rows: rows });\n  }\n}\n\nconst failed = results.filter((r) => r.problem_rows === null || r.problem_rows > 0);\nconst runAt = $now.setZone('America/La_Paz').toFormat('yyyy-MM-dd HH:mm:ss');\n\nconst cell = 'style=border:1px solid #ccc;padding:6px 10px;text-align:left';\nconst rowsHtml = failed.map((r) => '<tr><td ' + cell + '>' + esc(r.check_name) + '</td><td ' + cell + '>' + (r.problem_rows === null ? 'error' : r.problem_rows) + '</td></tr>').join('');\nconst tableHtml = '<table style=border-collapse:collapse;font-family:Arial,sans-serif;font-size:14px>' +\n  '<tr><th ' + cell + '>check_name</th><th ' + cell + '>problem_rows</th></tr>' + rowsHtml + '</table>';\nconst errors = failed.filter((r) => r.error);\nconst errorsHtml = errors.length === 0 ? '' :\n  '<p><b>Query errors:</b></p><ul>' + errors.map((r) => '<li><b>' + esc(r.check_name) + '</b>: ' + esc(r.error) + '</li>').join('') + '</ul>';\n\nconst emailHtml =\n  '<p>' + failed.length + ' data quality check(s) failed on <b>bigquery-public-data.thelook_ecommerce</b>.</p>' +\n  tableHtml + errorsHtml +\n  '<p style=color:#666;font-size:12px>Run at: ' + runAt + ' (America/La_Paz)<br>Workflow: Data Quality Checks - thelook_ecommerce</p>';\n\nreturn [{ json: { failed_count: failed.length, checks_run: results.length, failed_checks: failed, email_html: emailHtml, run_at: runAt } }];\n"
      },
