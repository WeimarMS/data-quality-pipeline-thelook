    {
      "parameters": {
        "projectId": {
          "__rl": true,
          "mode": "id",
          "value": "portafolio-bi-512400"
        },
        "sqlQuery": "SELECT\n  'item_count_mismatch' AS check_name,\n  COUNT(*) AS problem_rows\nFROM `bigquery-public-data.thelook_ecommerce.orders` o\nLEFT JOIN (\n  SELECT order_id, COUNT(*) AS actual_items\n  FROM `bigquery-public-data.thelook_ecommerce.order_items`\n  GROUP BY order_id\n) oi ON oi.order_id = o.order_id\nWHERE o.num_of_item IS DISTINCT FROM COALESCE(oi.actual_items, 0)",
        "options": {
          "maximumBytesBilled": "104857600",
          "useLegacySql": false
        }
      },
      "id": "b21b5ef1-e26b-43ae-ad45-34bd2b3f61d8",
